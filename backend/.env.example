# Azure OpenAI - powers the AI concierge (chat, voice and photo understanding)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=your_vision_capable_deployment_name
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# SerpAPI - live Google Maps, Images, Tripadvisor and AI Mode data
SERPAPI_KEY=your_serpapi_key_here

# Optional WhatsApp notifications via Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+919876543210
LOOKATE_PUBLIC_URL=https://your-public-lookate-url.example
